@model IEnumerable<ConcertBooking.Models.Concert>

<div class="container mt-5 pt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Dostępne Wydarzenia</h2>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">Dodaj nowy koncert</a>
        }
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <input type="text" id="searchInput" class="form-control bg-dark text-white border-secondary shadow-none" placeholder="Wyszukaj artystę..." autocomplete="off" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle" style="border-radius: 10px; overflow: hidden;">
            <thead style="background-color: #111;">
                <tr>
                    <th class="py-3 text-muted">Artysta / Nazwa</th>
                    <th class="py-3 text-muted">Data wydarzenia</th>
                    <th class="py-3 text-muted">Cena biletu</th>
                    <th class="py-3 text-muted">Dostępne miejsca</th>
                    <th class="py-3 text-muted">Akcje</th>
                </tr>
            </thead>
            <tbody id="concertsTableBody">
                <partial name="_ConcertListPartial" model="Model" />
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const tableBody = document.getElementById('concertsTableBody');

            
            searchInput.addEventListener('keyup', function () {
                const query = searchInput.value;

                
                fetch(`/Concerts/Search?query=${encodeURIComponent(query)}`)
                    .then(response => response.text())
                    .then(html => {
                        
                        tableBody.innerHTML = html;
                    })
                    .catch(error => console.error('Błąd podczas pobierania danych:', error));
            });
        });
    </script>
}