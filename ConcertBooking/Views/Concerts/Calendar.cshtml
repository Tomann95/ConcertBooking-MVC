@{
    ViewData["Title"] = "Kalendarz Wydarzeń";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Kalendarz Koncertów</h2>
        <a asp-action="Index" class="btn btn-outline-light rounded-pill">Wróć do listy</a>
    </div>

    <div class="glass-card p-4 shadow-lg">
        <div id="calendar"></div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/locales/pl.js"></script>

    <style>
        
        :root {
            --fc-border-color: rgba(255, 255, 255, 0.1);
            --fc-page-bg-color: transparent;
            --fc-neutral-bg-color: transparent;
            --fc-today-bg-color: rgba(255, 0, 127, 0.15); 
        }

        
        .fc a {
            color: #e0e0e0 !important;
            text-decoration: none;
            transition: color 0.2s;
        }

            .fc a:hover {
                color: var(--accent-color) !important;
            }

        
        .fc-theme-standard th {
            background-color: #111;
            border-color: rgba(255, 255, 255, 0.1);
            padding: 12px 0;
            text-transform: uppercase;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: 0.85rem;
            letter-spacing: 1px;
            color: #a0a0a0;
        }

        
        .fc .fc-button-primary {
            background-color: #1a1a1a;
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 1px;
            border-radius: 8px;
            padding: 8px 16px;
            transition: all 0.2s ease;
        }

            .fc .fc-button-primary:hover {
                background: var(--accent-gradient);
                border-color: transparent;
                box-shadow: 0 5px 15px rgba(255, 0, 127, 0.3);
            }

            .fc .fc-button-primary:not(:disabled):active,
            .fc .fc-button-primary:not(:disabled).fc-button-active {
                background: var(--accent-gradient);
                border-color: transparent;
                box-shadow: 0 5px 15px rgba(255, 0, 127, 0.4);
                color: white;
            }

        
        .fc-event {
            background: var(--accent-gradient);
            border: none;
            border-radius: 6px;
            padding: 4px 6px;
            color: #fff !important;
            font-weight: 700;
            font-size: 0.85rem;
            box-shadow: 0 4px 10px rgba(0,0,0,0.4);
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .fc-event:hover {
                transform: translateY(-2px) scale(1.02);
                box-shadow: 0 6px 15px rgba(255, 0, 127, 0.5);
            }

        .fc-daygrid-event-dot {
            display: none; 
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'pl',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                
                events: '/Concerts/GetConcertsForCalendar',

                
                height: 'auto',
                firstDay: 1, 
                buttonText: {
                    today: 'Dziś',
                    month: 'Miesiąc',
                    week: 'Tydzień',
                    day: 'Dzień'
                }
            });

            calendar.render();
        });
    </script>
}