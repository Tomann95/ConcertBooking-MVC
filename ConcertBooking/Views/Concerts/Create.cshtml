@model ConcertBooking.Models.Concert

@{
    ViewData["Title"] = "Dodaj Wydarzenie";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="feature-card shadow-lg p-5" style="border-top: 4px solid var(--accent-color);">
                <h2 class="fw-bold mb-4 text-white">Dodaj nowy koncert</h2>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3" style="color: #ff4d4d !important;"></div>

                    <div class="mb-4">
                        <label asp-for="ArtistName" class="form-label text-white opacity-75 fw-bold">Artysta / Wydarzenie</label>
                        <input asp-for="ArtistName" class="form-control form-control-lg" placeholder="Wprowadź nazwę..." />
                        <span asp-validation-for="ArtistName" class="text-danger fw-bold" style="color: #ff4d4d !important;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label text-white opacity-75 fw-bold">Opis</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Krótki opis wydarzenia..."></textarea>
                        <span asp-validation-for="Description" class="text-danger fw-bold" style="color: #ff4d4d !important;"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <label asp-for="EventDate" class="form-label text-white opacity-75 fw-bold">Data i godzina</label>
                            <input asp-for="EventDate" class="form-control" />
                            <span asp-validation-for="EventDate" class="text-danger fw-bold" style="color: #ff4d4d !important;"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="TicketPrice" class="form-label text-white opacity-75 fw-bold">Cena biletu</label>
                            <input asp-for="TicketPrice" type="text" class="form-control" placeholder="np. 149,00" />
                            <span asp-validation-for="TicketPrice" class="text-danger fw-bold" style="color: #ff4d4d !important;"></span>
                        </div>

                        <div class="col-md-4 mb-4">
                            <label asp-for="AvailableSeats" class="form-label text-white opacity-75 fw-bold">Pula miejsc</label>
                            <input asp-for="AvailableSeats" class="form-control" placeholder="np. 5000" />
                            <span asp-validation-for="AvailableSeats" class="text-danger fw-bold" style="color: #ff4d4d !important;"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-4 border-top border-secondary">
                        <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">Powrót do listy</a>
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5">
                            <i class="bi bi-save me-2"></i> Zapisz Koncert
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

