@{
    ViewData["Title"] = "Strona Główna";
}

<section class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content container">
        <h1 class="hero-title text-uppercase">
            Poczuj <br />
            <span style="background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Muzykę Na Żywo</span>
        </h1>
        <p class="hero-subtitle">
            Odkryj najlepsze wydarzenia, zanurz się w niesamowitej atmosferze i zarezerwuj swój bilet na niezapomniany wieczór. Bądź tam, gdzie grają Twoi ulubieni artyści.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Concerts" asp-action="Index" class="btn btn-primary">
                Kup Bilet
            </a>
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light">
                    Dołącz do nas
                </a>
            }
        </div>
    </div>
</section>

<section class="container mt-5 pt-5 mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-mic-fill feature-icon"></i>
                <h4 class="fw-bold mb-3">Topowi Artyści</h4>
                <p class="text-muted mb-0">
                    Współpracujemy z największymi agencjami. Od kameralnych koncertów po gigantyczne trasy stadionowe.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-lightning-charge-fill feature-icon"></i>
                <h4 class="fw-bold mb-3">Szybka Rezerwacja</h4>
                <p class="text-muted mb-0">
                    Nasz system pozwala na wybór miejsca i rezerwację w zaledwie kilka sekund. Zero kolejek.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-shield-lock-fill feature-icon"></i>
                <h4 class="fw-bold mb-3">Bezpieczeństwo</h4>
                <p class="text-muted mb-0">
                    Twój bilet jest cyfrowy i przypisany do konta. Pełna ochrona danych i wsparcie 24/7.
                </p>
            </div>
        </div>
    </div>
</section>